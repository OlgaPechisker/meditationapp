DATABASE_URL=postgresql://einat:einat@localhost:5432/einat_dev
# Generate a unique secret with at least 32 characters; never reuse this example value.
JWT_SECRET=
JWT_ISSUER=einat-api
JWT_AUDIENCE=einat-admin
# Development only. Production requires ADMIN_PASSWORD_HASH and rejects plaintext passwords.
ADMIN_PASSWORD=admin123
# From PowerShell, run: Set-Location server; node -e "import bcrypt from 'bcrypt'; console.log(await bcrypt.hash(process.argv[1], 12))" "replace-with-a-strong-password"
# ADMIN_PASSWORD_HASH=
PORT=3000

# Maximum active in-memory rate-limit buckets across all limiter namespaces.
RATE_LIMIT_MAX_BUCKETS=10000

# Image upload configuration
# STORAGE_PROVIDER: "local" for dev (default). Add "s3" or "azure" when deploying.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
# Base URL used to construct public image URLs (local only)
BASE_URL=http://localhost:3000
