{
  "name": "einat-website",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "npm exec --workspace=server -- prisma generate && npm run build --workspace=server",
    "start": "npm exec --workspace=server -- prisma migrate deploy && npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "db:migrate": "npm exec --workspace=server -- prisma migrate dev",
    "db:seed": "npm exec --workspace=server -- prisma db seed",
    "db:studio": "npm exec --workspace=server -- prisma studio",
    "e2e": "npm exec -- playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "npm exec -- playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:report": "npm exec -- playwright show-report playwright-report",
    "e2e:install": "npm exec playwright install -- --with-deps chromium"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.1.5"
  }
}
